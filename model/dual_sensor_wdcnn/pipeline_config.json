    "source": "float64; subtract each phase record mean; Hann=np.hanning(29440), symmetric",
    "phase_power": "P_a,b=abs(rfft(centered_phase*Hann))**2; shared_power=(sum(P_a)+sum(P_b))/2",
    "db": "db(P,D)=10*log10(max(P/max(D,1e-30),1e-15))",
    "clarke": "alpha=ia; beta=(ia+2*ib)/sqrt(3); magnitude=abs(alpha+j*beta)",
    "magnitude_power": "abs(rfft((magnitude-mean(magnitude))*Hann))**2",
    "local_white": "L=db((P_a+P_b)/2,shared_power); W=clip(L-gaussian_filter1d(L,sigma=max(.6*shaft_hz/(8000/29440),1),mode=nearest),-40,40); default truncate4",
    "channels": [
      "db(P_a,shared_power)",
      "db(P_b,shared_power)",
      "W",
      "db(magnitude_power,shared_power)"
    ],
    "grid": {
      "kind": "mechanical_order",
      "start": 0.25,
      "stop": 40.0,
      "length": 5120,
